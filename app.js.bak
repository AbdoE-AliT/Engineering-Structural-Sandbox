  for (let i = 0; i < 8; i++) out.push([
    (i % 2 ? 1 : -1) * w / 2,
    (Math.floor(i / 2) % 2 ? 1 : -1) * h / 2,
    (Math.floor(i / 4) % 2 ? 1 : -1) * d / 2
