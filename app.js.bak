// Square concrete pillar side (m) for axial load P (N) and height L (m).
// Crushing: A >= SF*P/fc. Euler, pinned ends: I >= SF*P*L^2/(pi^2*E), with I = s^4/12.
function pillarSide(P, L) {
  const m = MATS.concrete;
