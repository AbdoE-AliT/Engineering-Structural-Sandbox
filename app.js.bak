  if (L <= 0.05) return null;
  const pos = [0, Math.min(b.size[1], c.size[1]) / 2, 0];
  pos[ax] = (b.pos[ax] + c.pos[ax]) / 2;
  pos[other] = b.pos[other];
  const size = [0.2, 0.2, 0.2];
  size[ax] = L;
